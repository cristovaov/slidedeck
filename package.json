{
	"name": "site-config",
	"private": true,
	"type": "module",
	"version": "1.0.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"start": "npm-run-all clean dev",
		"dev": "npx @11ty/eleventy --serve",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"build": "npm-run-all clean build:eleventy",
		"build:eleventy": "cross-env ELEVENTY_ENV=production npx @11ty/eleventy",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . --check",
		"format:fix": "prettier . --write",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@11ty/eleventy": "3.1.6",
		"@11ty/eleventy-img": "6.0.4",
		"@apleasantview/eleventy-plugin-baseline": "0.1.0-next.44"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"cross-env": "10.1.0",
		"eslint": "10.6.0",
		"globals": "17.7.0",
		"npm-run-all": "4.1.5",
		"prettier": "3.9.4",
		"prettier-plugin-jinja-template": "2.2.0",
		"rimraf": "6.1.3",
		"sharp": "0.35.3"
	},
	"allowScripts": {
		"sharp@0.33.5": true,
		"esbuild@0.28.1": true
	}
}
